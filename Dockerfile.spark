FROM apache/spark:3.5.1

USER root

# Instalar dependências básicas 
RUN apt-get update && apt-get install -y wget && rm -rf /var/lib/apt/lists/*

# JARs para acesso ao S3 (s3a://)
RUN wget -P /opt/spark/jars/ \
    https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar && \
    wget -P /opt/spark/jars/ \
    https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.367/aws-java-sdk-bundle-1.12.367.jar

# Diretório dos jobs (volume)
RUN mkdir -p /jobs && \
    chown -R 1001:1001 /jobs

# Diretório Ivy (ESSENCIAL para evitar erro)
RUN mkdir -p /tmp/.ivy2 && \
    chown -R 1001:1001 /tmp/.ivy2

# Criar usuário válido
RUN useradd -u 1001 -m spark

# Usuário com nome
USER spark

# Variável de ambiente Spark 
ENV USER=spark

# Ivy configurado
ENV SPARK_SUBMIT_OPTS="-Divy.home=/tmp/.ivy2 -Divy.cache.dir=/tmp/.ivy2"

WORKDIR /jobs